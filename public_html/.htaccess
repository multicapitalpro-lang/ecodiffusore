RewriteEngine On

# Fase 76: alguns setups de hospedagem (CGI/FastCGI) nao repassam o header Authorization pro PHP
# por padrao -- sem isso, App\Core\ApiAuth nao consegue ler o Bearer token da API.
RewriteCond %{HTTP:Authorization} ^(.*)
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Se o arquivo ou pasta existir de verdade (assets), serve direto
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Caso contrário, tudo passa pelo front controller
RewriteRule ^ index.php [L]

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

Options -Indexes
